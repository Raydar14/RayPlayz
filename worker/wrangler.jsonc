// Cloudflare Worker config for the RayPlayz site + private dashboard.
// After editing this file, redeploy with `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Cloudflare project name so Wrangler and the CI system agree.
  "name": "rayplayz",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets: everything in ./public is served as-is unless the Worker intercepts.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Non-secret config. Secrets (DASHBOARD_PASSWORD, SESSION_SECRET, ANTHROPIC_API_KEY)
  // are set via the Cloudflare dashboard or `wrangler secret put`, never in this file.
  "vars": {
    "SESSION_MAX_AGE_HOURS": "168"
  },

  // D1 (SQLite on the edge). Schema in worker/migrations/0001_init.sql is
  // applied on demand by src/db.js on first DB access — no manual migration
  // step required.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rayplayz-db",
      "database_id": "75426423-8a86-4888-8dfa-e145d7faaf50"
    }
  ]

  // Custom domain routes are attached from the Cloudflare dashboard once DNS is live:
  //   rayplayzz.com/*   →  rayplayz
  //   www.rayplayzz.com/*   →  rayplayz
}
